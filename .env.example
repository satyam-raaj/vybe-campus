# Required in production
VYBE_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://...

# Launch remains locked until you deliberately set this to 1 after the checklist is complete.
VYBE_LAUNCH_READY=0
VYBE_PUBLIC_DOMAIN=vybecampus.org

# Optional WebAuthn configuration for the final custom domain
VYBE_PASSKEY_RP_ID=vybecampus.org
VYBE_PASSKEY_ORIGIN=https://vybecampus.org

# Optional external AI is disabled by default. VYBE's built-in assistant is deterministic and free.
# VYBE_AI_API_KEY=
# VYBE_AI_ENDPOINT=
# VYBE_AI_MODEL=
