# Required in production
VYBE_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Set this only for the first production setup if you want VYBE to
# create the initial admin password in the database.
# After setting the admin password, remove this variable from Render.
VYBE_ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password

# Optional WebAuthn configuration.
# For the Render URL, these can normally be left unset because the app
# derives them from RENDER_EXTERNAL_HOSTNAME.
# VYBE_PASSKEY_RP_ID=your-domain.example
# VYBE_PASSKEY_ORIGIN=https://your-domain.example

# Optional external AI. VYBE's built-in assistant works without these.
# VYBE_AI_API_KEY=
# VYBE_AI_ENDPOINT=https://api.openai.com/v1/responses
# VYBE_AI_MODEL=gpt-5.6-luna
